# Copy to .env.local and fill in. All of these are NEXT_PUBLIC_*, so they end
# up in the browser bundle: never put a secret here.

# Backend API base, including /api/v1/.
NEXT_PUBLIC_API_URL=https://api.themarcopassport.com/api/v1/

# Host that image paths from the API (e.g. /images/abc.jpg) are relative to.
# No trailing slash.
NEXT_PUBLIC_IMAGE_URL=https://api.themarcopassport.com

# Google Maps Embed API key for the itinerary map (My Passport).
# Use a separate browser key restricted to:
#   - API restrictions: "Maps Embed API" only
#   - Application restrictions: HTTP referrers = this site's domains
# The Embed API is free; don't enable the Maps JavaScript, Directions, Places
# or Geocoding APIs on this key (they're billed). If left empty, the map shows
# a placeholder and only the "Directions" links work.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
